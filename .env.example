DATABASE_URL=postgresql://concierge:concierge@localhost:5433/concierge
POSTGRES_USER=concierge
POSTGRES_PASSWORD=concierge
POSTGRES_DB=concierge

AUTH_SECRET=change-me-to-32-random-chars
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-32-random-chars
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# TRUSTED_ORIGINS=http://localhost:3000

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo seed (scripts only, never production).
# ALLOW_DEMO_SEED=true
# SEED_ADMIN_EMAIL=admin@orangeconcierge.test
# SEED_ADMIN_NAME=Test Admin
# SEED_ADMIN_PASSWORD=DemoAdmin123!
# SEED_CONSULTANT_EMAIL=consultant@orangeconcierge.test
# SEED_CONSULTANT_NAME=Test Consultant
# SEED_CONSULTANT_PASSWORD=DemoConsultant123!
# SEED_REVIEWER_EMAIL=reviewer@orangeconcierge.test
# SEED_REVIEWER_NAME=Test Reviewer
# SEED_REVIEWER_PASSWORD=DemoReviewer123!

# AI extraction uses local Ollama by default.
AI_PROVIDER=ollama
AI_MODEL=llama3.2
# AI_BASE_URL=http://localhost:11434
# AI_TIMEOUT_MS=30000

# Gemini cloud mode.
# Use: docker compose -f docker-compose.yml -f docker-compose.cloud.yml up -d
# AI_PROVIDER=gemini
# AI_MODEL=gemini-1.5-flash
# AI_API_KEY=replace-with-gemini-api-key
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
