# M2: database + M5: AI providers + M3: auth

# Database
DATABASE_URL=postgresql://concierge:concierge@localhost:5433/concierge
POSTGRES_USER=concierge
POSTGRES_PASSWORD=concierge
POSTGRES_DB=concierge

# Auth (M3)
AUTH_SECRET=change-me-to-32-random-chars

# AI — choose one (M5)
# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Google Gemini (free tier)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
# Provider selector: deepseek | gemini | ollama | mock
AI_PROVIDER=mock

# Ollama (M9, profile sovereign)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
