{
  "name": "orange-concierge",
  "version": "0.1.0",
  "private": true,
  "description": "Sovereign Client Operations Copilot — self-hosted AI platform for Bitcoin consultancy",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter ./apps/operations dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @orange-concierge/database generate",
    "db:migrate": "pnpm --filter @orange-concierge/database migrate",
    "eval": "pnpm --filter @orange-concierge/ai eval"
  },
  "keywords": ["mastra", "self-hosted", "bitcoin", "sovereign"],
  "license": "MIT"
}
