# Postgres — use strong unique values.
POSTGRES_USER=concierge
POSTGRES_PASSWORD=CHANGE-ME-to-a-long-random-password
POSTGRES_DB=concierge

# App — must be your public HTTPS URL.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.example
BETTER_AUTH_URL=https://your-domain.example
BETTER_AUTH_TRUSTED_ORIGINS=https://your-domain.example
TRUSTED_ORIGINS=https://your-domain.example

# Auth — must be long random secrets, different from each other.
# Generate with `openssl rand -base64 32`.
AUTH_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-32
BETTER_AUTH_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-32-different-from-auth-secret

# Option A: self-hosted Ollama (default compose stack).
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_TIMEOUT_MS=30000
# AI_BASE_URL defaults to http://ollama:11434 inside Docker.
# Only set this if Ollama runs somewhere else.
# AI_BASE_URL=http://ollama:11434

# Option B: Gemini cloud (use the cloud compose override).
# AI_PROVIDER=gemini
# AI_MODEL=gemini-1.5-flash
# AI_TIMEOUT_MS=30000
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_API_KEY=CHANGE-ME-to-your-gemini-api-key
